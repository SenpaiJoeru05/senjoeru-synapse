node_modules/
dist/
.env

# Piper neural TTS: piper.exe plus a voice model, ~80MB of binary that does not
# belong in git. Fetched by `npm run voice:setup`.
vendor/
.DS_Store
*.log
frontend/dist/
backend/.env
collectors/.env
metrics/*.json
!metrics/.gitkeep
# The example config must ship — it is the only setup guidance a new clone gets.
!metrics/config.example.json

# The task board your agents write. Local user data, like the database below.
# Ignore the contents, not the directory — git cannot un-ignore a file inside
# an ignored directory, so `data/` would swallow the .gitkeep too.
data/*
!data/.gitkeep

# SQLite application database (permanent local data — never committed)
backend/data/
*.db
*.db-wal
*.db-shm
